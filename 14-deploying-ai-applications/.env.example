# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.
#
# This module's .bat scripts read from 00_setup_vars.bat (Command Prompt
# doesn't load .env natively) — keep the two in sync. This .env.example
# documents the same keys for consistency with every other module.

PROJECT_ID=agentic-ai-capstone-1
REGION=us-central1
LOCATION=us-central1

REPO_NAME=deploying-ai-apps
SUMMARIZER_SERVICE_NAME=news-summarizer
FETCHER_FUNCTION_NAME=news-fetcher

SUMMARIZER_SA_NAME=news-summarizer-sa
FETCHER_SA_NAME=news-fetcher-sa

SECRET_NAME=telegram-bot-token

# DUMMY VALUES — replace with your real Telegram bot details (topic 5 shows
# exactly how to get these via @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Any public RSS feed works. NOT Google News's /rss/search endpoint - Google
# blocks that endpoint's traffic from Google Cloud's own egress IP ranges
# with a 503 "Sorry..." bot-detection page (confirmed in this module's
# actual Cloud Functions deploy - works fine from a residential/laptop IP,
# fails from every GCP-hosted caller). This default is TechCrunch's AI tag feed.
RSS_FEED_URL=https://techcrunch.com/tag/artificial-intelligence/feed/

# Filled in AFTER topic 3's deploy — paste the printed Cloud Run service URL here
SUMMARIZER_URL=https://REPLACE-ME-AFTER-TOPIC-3.run.app
