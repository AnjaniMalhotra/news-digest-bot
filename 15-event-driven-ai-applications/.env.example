# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.
#
# This module's .bat scripts read from 00_setup_vars.bat (Command Prompt
# doesn't load .env natively) — keep the two in sync.

PROJECT_ID=agentic-ai-capstone-1
REGION=us-central1
LOCATION=us-central1

TOPIC_NAME=digest-requests
FEEDS_BUCKET_NAME=digest-feeds-bucket
QUEUE_NAME=digest-fetch-queue

WORKER_SA_NAME=digest-worker-sa
TASKS_SA_NAME=digest-tasks-sa

SECRET_NAME=telegram-bot-token-eventdriven

# DUMMY VALUES — replace with your real Telegram bot details (same bot from
# Module 14 works fine, or create a fresh one via @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Filled in AFTER topic 4's function deploy - paste the printed URL here
WORKER_HTTP_URL=https://REPLACE-ME-AFTER-TOPIC-4.run.app

# Topic 5 - API Gateway
API_ID=digest-api
API_CONFIG_ID=digest-config
GATEWAY_ID=digest-gateway
